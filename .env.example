QORTIUM_CONTAINER_NAME=qortium-core
QORTIUM_NETWORK_NAME=qortium-net

# Published/container ports. Keep these in sync with the operator-owned
# ./data/qortium/settings.json. Fresh volumes use the bundled Previewnet profile.
QORTIUM_API_PORT=24891
QORTIUM_P2P_PORT=24892
QORTIUM_QDN_PORT=24894

# Host bind addresses used by docker-compose.yml
QORTIUM_API_BIND_HOST=127.0.0.1
QORTIUM_P2P_BIND_HOST=0.0.0.0
QORTIUM_QDN_BIND_HOST=0.0.0.0
